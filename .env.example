# Copie este archivo como .env y complete los valores. NUNCA suba .env a GitHub.

# --- Servidor ---
NODE_ENV=development
PORT=3000
# Orígenes (separados por coma) que pueden leer respuestas desde un navegador (CORS).
# Vacío = solo clientes que no son navegador (Postman, curl).
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=America/Lima

# Acceso libre: cualquier correo y contraseña inicia sesión (solo demostración; se ignora en producción).
ACCESO_LIBRE=true

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laboratorio_prestamos
DB_NAME_TEST=laboratorio_prestamos_test
DB_USER=
DB_PASSWORD=

# --- Seguridad ---
# Cadena aleatoria de al menos 32 caracteres. Genere una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# --- Límite de peticiones (por IP) ---
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=300
